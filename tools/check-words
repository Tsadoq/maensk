#!/usr/bin/env python3
"""Fail when a file holds a forbidden word or a session id.

check-words [FILE...]   scan the files, or every tracked file when none is given
check-words --hash LIST write the hashes of the words in LIST, one entry per line

The repo is public, so the word list is kept as SHA-256 hashes beside this script.
"""

import hashlib
import pathlib
import re
import subprocess
import sys

HASHES = pathlib.Path(__file__).with_name("forbidden-words.sha256")
SESSION_ID = re.compile(r"\b[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\b", re.IGNORECASE)
MAX_WORDS = 3


def words(text):
    return re.findall(r"[a-z0-9]+", text.lower())


def digest(entry):
    return hashlib.sha256(" ".join(entry).encode()).hexdigest()


def write_hashes(list_path):
    hashes = set()
    for number, line in enumerate(pathlib.Path(list_path).read_text().splitlines(), 1):
        entry = words(line)
        if len(entry) > MAX_WORDS:
            sys.exit(f"check-words: line {number} has more than {MAX_WORDS} words")
        if entry:
            hashes.add(digest(entry))
    HASHES.write_text("".join(f"{value}\n" for value in sorted(hashes)))
    print(f"wrote {len(hashes)} hash(es) to {HASHES}")


def findings(path, forbidden):
    text = pathlib.Path(path).read_text(errors="ignore")
    for number, line in enumerate(text.splitlines(), 1):
        if SESSION_ID.search(line):
            yield f"{path}:{number}: session id"
        found = words(line)
        for size in range(1, MAX_WORDS + 1):
            for start in range(len(found) - size + 1):
                if digest(found[start : start + size]) in forbidden:
                    yield f"{path}:{number}: forbidden word"


def main(args):
    if args[:1] == ["--hash"]:
        if len(args) != 2:
            sys.exit("check-words: --hash needs the path of the word list")
        write_hashes(args[1])
        return 0
    forbidden = set(HASHES.read_text().split())
    files = args or subprocess.run(
        ["git", "ls-files"], capture_output=True, text=True, check=True
    ).stdout.splitlines()
    found = sorted(
        {line for path in files if pathlib.Path(path).is_file() for line in findings(path, forbidden)}
    )
    for line in found:
        print(line)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
